{
  "name": "recursion",
  "private": true,
  "version": "0.1.27",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "vite": "vite",
    "build:ui": "vite build",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "app": "tauri build",
    "smoke": "cargo build -p recursiond && node scripts/smoke.mjs",
    "test": "cargo test -p recursiond && pnpm typecheck && pnpm smoke",
    "test:agent": "cargo build -p recursiond && node scripts/agent-smoke.mjs",
    "test:group": "cargo build -p recursiond && node scripts/group-smoke.mjs",
    "test:codex": "cargo build -p recursiond && node scripts/codex-smoke.mjs",
    "test:poll": "cargo build -p recursiond && node scripts/poll-smoke.mjs",
    "test:doc": "cargo build -p recursiond && node scripts/doc-smoke.mjs",
    "test:thread": "cargo build -p recursiond && node scripts/thread-smoke.mjs",
    "test:browse": "cargo build -p recursiond -p recursion-app && node scripts/browse-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.18",
    "highlight.js": "11.11.1",
    "lucide-react": "1.72.0",
    "marked": "15.0.12",
    "marked-highlight": "2.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}