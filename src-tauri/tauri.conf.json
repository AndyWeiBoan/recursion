{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recursion",
  "version": "0.1.24",
  "identifier": "dev.recursion.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bash scripts/sidecar.sh && pnpm vite",
    "beforeBuildCommand": "bash scripts/sidecar.sh release && pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Recursion",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/recursiond"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNDg3NjA4MTI1NUVDQjcKUldTMzdGVVNDSFpJWVZEOVVBV1BDNEpXTlI1NDNnbUV2UkQwOFNZUmFBSkJkWkQxZGhvWGMzTU0K",
      "endpoints": [
        "https://github.com/AndyWeiBoan/recursion-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
